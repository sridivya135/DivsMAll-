# Copy to .env and adjust. NEVER commit your real .env file.

# --- Django ---
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=UTC

# --- Database ---
# MySQL is used by default. Set USE_SQLITE=true for a zero-config local database.
USE_SQLITE=true
DB_NAME=divs_mall
DB_USER=root
DB_PASSWORD=change-me
DB_HOST=127.0.0.1
DB_PORT=3306

# --- Frontend access ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# --- Production security (set these when deploying over HTTPS) ---
# SECURE_SSL_REDIRECT=true
# COOKIE_SECURE=true
# SECURE_HSTS_SECONDS=31536000

# --- Invoice / business details ---
MALL_NAME=Div's Mall
MALL_ADDRESS=Main Market Road, Shopping District
MALL_CITY=
MALL_PHONE=
MALL_EMAIL=
MALL_GSTIN=
LOW_STOCK_THRESHOLD=10
